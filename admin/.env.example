# Merge with the existing private .env; never overwrite/remove existing OLOS credentials.
ADMIN_ORIGIN=https://painel.example.com
ADMIN_BIND=0.0.0.0
ADMIN_PORT=8080
# 32 random bytes encoded as 64 hex characters, managed OUTSIDE PostgreSQL.
ADMIN_ENCRYPTION_KEY=
# Optional exact approved origins. Empty defaults to the operational OLOS_BASE_URL origin.
ADMIN_OLOS_ALLOWED_ORIGINS=
# Exact OLOS identities allowed to administer the panel. Passwords are validated ONLY by OLOS.
# Example: ["olos.administrador"] — never grant all authenticated OLOS users access.
ADMIN_OLOS_USERS_JSON=

# Analytical calls source: MADM, strictly read only. No delivery write permission needed.
ADMIN_REPORT_CONTRACT_VERSION=2
# Optional dedicated SELECT-only credential; otherwise use configured OLOS corporate endpoint.
ADMIN_REPORT_CORPORATE_DATABASE_URL=
ADMIN_REPORT_CORPORATE_CA_FILE=
# Required ONLY when corporate data_ligacao is timestamp without time zone.
# Obtain explicit confirmation of the stored wall-clock semantics before setting.
ADMIN_REPORT_TIMESTAMP_ZONE=
ADMIN_REPORT_TIMESTAMP_CONFIRMATION=
