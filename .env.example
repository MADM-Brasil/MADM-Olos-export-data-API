# Real credentials stay outside Git. Configure these in Dokploy or a private env file.
OLOS_BASE_URL=https://HOST/WebApiExportData
OLOS_USERNAME=
OLOS_PASSWORD=
OLOS_CLIENT_ID=
OLOS_CLIENT_SECRET=
DATABASE_URL=
# Stable identity of the OLOS installation/consumption account. All consumers must share it AND this database.
OLOS_SOURCE_KEY=olos-production
DESTINATION_SCHEMA=raw
DESTINATION_TABLE=olos_calls
# Confirm using real authorized samples across days before enabling ingestion.
SOURCE_ID_UNIQUENESS_CONFIRMED=false
# Required only for StartDate without UTC offset. Confirm the source timezone; do not guess.
SOURCE_TIME_ZONE=
# Preserve the operationally approved baseline; start/admin consumption requires it.
INGESTION_BASELINE=
# Initial scheduler interval only; persisted settings take precedence (1–60 minutes).
POLL_INTERVAL_MS=120000
HTTP_TIMEOUT_MS=10000
DB_POOL_MAX=5
BATCH_SIZE=500
STATIC_CACHE_TTL_MS=3600000
MAX_RESPONSE_BYTES=33554432
MAX_RETRY_ATTEMPTS=5

# Keep true normally. false disables certificate validation only for the OLOS HTTP client.
OLOS_TLS_VERIFY=true
WORKER_COMMAND=check
