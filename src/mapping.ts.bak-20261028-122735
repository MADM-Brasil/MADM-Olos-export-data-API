export const columns = ['olos_call_id', 'data_ligacao', 'telefone', 'nome_agente', 'id_campanha_olos',
  'nome_campanha_olos', 'id_tabulacao_olos', 'nome_tabulacao_olos', 'cpf', 'lead_id_origem', 'tma_origem',
  'razao_desligamento', 'email', 'raw_olos_call_id', 'telefone_match_key'] as const;
export const sourceColumns = ['AttemptsRawDataID', 'CallId', 'AgentId', 'CampaignId', 'DispositionId', 'StartDate',
  'EndWrap', 'TableName', 'EndCall', 'OriginalPhoneNumber', 'Dnis', 'PhoneTypeId', 'Route', 'CampaignData',
  'CustomerId', 'MailingRecordId', 'MailingPhoneNumberId', 'CallIdTelecom'] as const;
export type Cache = { users: Map<string, string>; campaigns: Map<string, string>; dispositions: Map<string, string> };
export function textValue(value: unknown): string | null {
