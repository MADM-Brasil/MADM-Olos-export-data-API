# Independent configuration; never reuse the operational .env.
CORPORATE_SYNC_SOURCE_URL=postgresql://sync_local:REPLACE@DOKPLOY_HOST:5432/LOCAL_DB
CORPORATE_SYNC_DESTINATION_URL=postgresql://sync_corporate:REPLACE@MADM_HOST:5432/CORPORATE_DB
CORPORATE_SYNC_SOURCE_TLS=true
CORPORATE_SYNC_DESTINATION_TLS=true
# Mount private CA files in the standalone service if necessary.
# CORPORATE_SYNC_SOURCE_CA_FILE=/run/secrets/local-ca.pem
# CORPORATE_SYNC_DESTINATION_CA_FILE=/run/secrets/corporate-ca.pem
CORPORATE_SYNC_ENABLED=false
CORPORATE_SYNC_WRITE_CONFIRMATION=
CORPORATE_SYNC_IDENTITY_CONFIRMATION=
CORPORATE_SYNC_TMA_POLICY=reject
CORPORATE_SYNC_TMA_CONFIRMATION=
CORPORATE_SYNC_TIMESTAMP_ZONE=
CORPORATE_SYNC_TIMESTAMP_CONFIRMATION=
CORPORATE_SYNC_BATCH_SIZE=250
CORPORATE_SYNC_INTERVAL_MS=30000
CORPORATE_SYNC_MAX_RETRIES=3
CORPORATE_SYNC_BACKOFF_MS=500
CORPORATE_SYNC_TIMEOUT_MS=15000
