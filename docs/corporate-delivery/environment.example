# Apply to the EXISTING ExportDataV3 service only in a separately approved window.
# DATABASE_URL and existing OLOS settings remain local/unchanged.
ATTEMPTS_PERSISTENCE_MODE=corporate
OLOS_CORPORATE_DATABASE_URL=postgresql://APP_USER:REPLACE@MADM_HOST:5432/madm
OLOS_CORPORATE_CA_FILE=/run/secrets/madm-ca.pem
OLOS_CORPORATE_TLS_VERIFY=true
OLOS_CORPORATE_WRITE_ENABLED=false
OLOS_CORPORATE_WRITE_CONFIRMATION=
OLOS_CORPORATE_LEGACY_EXPECTED_COUNT=12605
# Exact existing corporate_sync.control.binding (64 hex chars), from an authorized local audit.
OLOS_CORPORATE_LEGACY_BINDING=
OLOS_CORPORATE_RECONCILE_CONFIRMATION=
# Required only if the actual corporate data_ligacao is timestamp WITHOUT time zone.
OLOS_CORPORATE_TIMESTAMP_ZONE=
OLOS_CORPORATE_TIMESTAMP_CONFIRMATION=
OLOS_CORPORATE_BATCH_SIZE=250
OLOS_CORPORATE_TIMEOUT_MS=15000
OLOS_CORPORATE_BACKOFF_MS=1000
OLOS_CORPORATE_MAX_FAILURES=5
